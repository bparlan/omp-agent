{
  "test_cases": [
    {
      "name": "python_runtime_detection",
      "input": {
        "project_path": "/tmp/test-python",
        "requirements": {"language": "python", "version": "3.9"}
      },
      "expected": {
        "status": "success",
        "detected": {"language": "python", "version": "3.9", "installed": true}
      }
    },
    {
      "name": "workspace_isolation",
      "input": {
        "project_path": "/tmp/test-isolation",
        "config": {"method": "per-project", "strict": true}
      },
      "expected": {
        "status": "success",
        "isolated": true,
        "boundary_enforced": true
      }
    },
    {
      "name": "cross_language_compatibility",
      "input": {
        "language": "node",
        "version": "18",
        "project": {"package.json": true, "dependencies": ["express"]}
      },
      "expected": {
        "status": "success",
        "compatible": true,
        "alternative_versions": ["19", "20"]
      }
    }
  ]
}