#!/usr/bin/env python3
"""Traceability verification CLI: validates relationship fields against canonical model."""
import re
import sys
from pathlib import Path

import yaml


ALLOWED_RELATIONSHIPS = {"derived_from", "verifies", "tests", "implements", "evaluates", "reviews"}
IDENTITY_PATTERN = re.compile(r"^[A-Z0-9_-]+$")


def _load_frontmatter(path: Path) -> dict:
    content = path.read_text(encoding='utf-8')
    match = re.match(r"\A---\s*$(.*?)^---\s*$", content, re.DOTALL | re.MULTILINE)
    if not match:
        return {}
    data = yaml.safe_load(match.group(1))
    return data if isinstance(data, dict) else {}


def validate(path: Path) -> bool:
    frontmatter = _load_frontmatter(path)
    relationships = frontmatter.get('relationships')
    if not isinstance(relationships, dict):
        print(f"INVALID: missing relationships object in {path}", file=sys.stderr)
        return False
    for rel_type, values in relationships.items():
        if rel_type not in ALLOWED_RELATIONSHIPS:
            print(f"INVALID: unknown relationship type {rel_type} in {path}", file=sys.stderr)
            return False
        if not isinstance(values, list):
            print(f"INVALID: relationship {rel_type} is not an array in {path}", file=sys.stderr)
            return False
        for value in values:
            if not isinstance(value, str) or not IDENTITY_PATTERN.match(value):
                print(f"INVALID: relationship {rel_type} contains invalid identity {value} in {path}", file=sys.stderr)
                return False
    print("VALID")
    return True


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("Usage: omp-verify-traceability <artifact_path>", file=sys.stderr)
        return 1
    path = Path(argv[1])
    if not path.exists():
        print(f"Artifact not found: {path}", file=sys.stderr)
        return 1
    return 0 if validate(path) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
