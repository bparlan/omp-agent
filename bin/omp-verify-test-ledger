#!/usr/bin/env python

import argparse
import os
import sys
import json
from pathlib import Path
import re # Import re module for regex operations

def validate_ledger(ledger_path, verification_path, test_dir):
    print(f"Validating ledger: {ledger_path}, verification: {verification_path}, test_dir: {test_dir}")

    # FR-4: Precise Test Ledger Schema validation
    try:
        with open(ledger_path, 'r', encoding='utf-8') as f:
            ledger_content = f.read()

        # Regex for ledger header. Needs to be precise to avoid false positives.
        # Matches the exact header line: | Test File | Verification ID | Requirement ID | Test Type |
        ledger_header_pattern = r'^\|\s*Test File\s*\|\s*Verification ID\s*\|\s*Requirement ID\s*\|\s*Test Type\s*\|$'
        if not re.search(ledger_header_pattern, ledger_content, re.MULTILINE):
            print(f"FAIL: Ledger schema header not found or incorrect in {ledger_path}", file=sys.stderr)
            return False

        # Parse ledger data rows for test files and other relevant info
        test_file_paths = []
        lines = ledger_content.splitlines()
        header_found = False

        for line in lines:
            if line.startswith('|') and 'Test File' in line and 'Verification ID' in line:
                # Distinguish between header and data rows using the header pattern
                if re.match(ledger_header_pattern, line):
                    header_found = True
                    continue

                if header_found and line.startswith('|'):
                    # This is a data row. Parse it.
                    parts = [part.strip() for part in line.split('|')]
                    # Expected format: | test_file | verification_id | requirement_id | test_type |
                    # After split, parts will have empty strings at the beginning and end.
                    # So, parts[1] is Test File, parts[2] is Verification ID, etc.
                    if len(parts) >= 5:
                        test_file_path_str = parts[1]
                        verification_id = parts[2]
                        requirement_id = parts[3]
                        test_type = parts[4]

                        if not test_file_path_str or not verification_id or not requirement_id or not test_type:
                            print(f"FAIL: Incomplete data in ledger row: {line} in {ledger_path}", file=sys.stderr)
                            return False

                        test_file_paths.append(test_file_path_str)

        if not header_found:
            print(f"FAIL: Ledger schema header not found in {ledger_path}", file=sys.stderr)
            return False

        if not test_file_paths: # If header was found but no data rows with test files extracted
            print(f"FAIL: No test files found in ledger: {ledger_path}", file=sys.stderr)
            return False

        # FR-5: Test File Header Comments validation
        # Iterate through extracted test file paths and validate their headers.
        for tf_path_str in test_file_paths:
            full_test_file_path = Path(test_dir) / tf_path_str
            if not full_test_file_path.is_file():
                print(f"FAIL: Test file not found: {full_test_file_path}", file=sys.stderr)
                return False

            try:
                with open(full_test_file_path, 'r', encoding='utf-8') as tf:
                    tf_content = tf.read()

                # Regex for required header comments.
                # These patterns need to match '# {Verification IDs: ...}' and '# {Requirement IDs: ...}'.
                # Ensure proper escaping for regex metacharums like braces and colons.
                verification_id_pattern = r'^# \{{Verification IDs: .+\}}\s*$'
                requirement_id_pattern = r'^# \{{Requirement IDs: .+\}\s*$'

                if not re.search(verification_id_pattern, tf_content, re.MULTILINE):
                    print(f"FAIL: Missing or malformed Verification IDs header in test file: {full_test_file_path}", file=sys.stderr)
                    return False
                if not re.search(requirement_id_pattern, tf_content, re.MULTILINE):
                    print(f"FAIL: Missing or malformed Requirement IDs header in test file: {full_test_file_path}", file=sys.stderr)
                    return False

            except FileNotFoundError:
                print(f"FAIL: Test file not found during header check: {full_test_file_path}", file=sys.stderr)
                return False
            except Exception as e:
                print(f"FAIL: Error checking test file header for {full_test_file_path}: {e}", file=sys.stderr)
                return False

    except FileNotFoundError:
        print(f"FAIL: Ledger file not found during validation: {ledger_path}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"FAIL: Error during validation process: {e}", file=sys.stderr)
        return False

    # If all checks pass, return True. The main function will use this for exit codes.
    # FR-2 (Success) and FR-3 (Failure) logic is tied to this return value.
    return True

def main():
    parser = argparse.ArgumentParser(description='Verify test ledger and execution plan.')
    parser.add_argument('--ledger', required=True, help='Path to the test plan markdown file.')
    parser.add_argument('--verification', required=True, help='Path to the verification protocol document.')
    parser.add_argument('--test-dir', required=True, help='Directory containing the executable test files.')

    args = parser.parse_args()

    # Input Validation (FR-6)
    if not Path(args.ledger).is_file():
        print(f"FAIL: Ledger file not found: {args.ledger}", file=sys.stderr)
        sys.exit(1)
    if not Path(args.verification).is_file():
        print(f"FAIL: Verification file not found: {args.verification}", file=sys.stderr)
        sys.exit(1)
    if not Path(args.test_dir).is_dir():
        print(f"FAIL: Test directory not found: {args.test_dir}", file=sys.stderr)
        sys.exit(1)

    # Core Validation Logic (FR-1, FR-2, FR-3, FR-4, FR-5)
    # SPEC_FILE: Derive from ledger path. Extract milestone and spec IDs.
    SPEC_FILE = None  # Reserved for future FR-4 spec content validation

    validation_success = validate_ledger(args.ledger, args.verification, args.test_dir)

    # FR-2 & FR-3: Determine exit code based on validation result
    if validation_success:
        sys.exit(0)  # Success
    else:
        sys.exit(1)  # Failure

if __name__ == '__main__':
    main()
