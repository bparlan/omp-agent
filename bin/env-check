#!/usr/bin/env bash
# env-check — FR-1.1 Environment Management
# Language-agnostic environment validation: --project <path> --runtime <runtime> [--validate]
set -euo pipefail
cd "$(dirname "$0")/../" || exit 1
exec python3 -c "
import sys, os
sys.path.insert(0, 'src')
import argparse
from env_layer.cli.handlers.env_management import handle_env_check
p = argparse.ArgumentParser()
p.add_argument('--project', required=True)
p.add_argument('--runtime', required=True)
p.add_argument('--validate', action='store_true', default=False)
p.add_argument('--json', action='store_true', default=False)
args = p.parse_args()
handle_env_check(args)
" "$@"
