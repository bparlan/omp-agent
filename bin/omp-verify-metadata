#!/usr/bin/env python3
import sys
import os
import subprocess

def main():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    # Resolves validate_metadata.py in the same directory (bin/)
    binary_path = os.path.join(script_dir, 'validate_metadata.py')
    
    # If not found in the same directory, search project root
    if not os.path.exists(binary_path):
        binary_path = os.path.join(os.path.dirname(script_dir), 'validate_metadata.py')
        
    cmd = [sys.executable, binary_path] + sys.argv[1:]
    result = subprocess.run(cmd)
    sys.exit(result.returncode)

if __name__ == '__main__':
    main()