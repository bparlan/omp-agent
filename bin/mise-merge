#!/usr/bin/env python3
"""mise merge command for AEF Environment Layer"""

import sys
import json
import yaml
from pathlib import Path
import argparse


def merge_configs(base_path, override_path, output_path):
    """Merge two configuration files"""
    print("Merging mise configurations")
    print(f"Base: {base_path}")
    print(f"Override: {override_path}")
    print(f"Output: {output_path}")
    print("=" * 50)

    base_file = Path(base_path)
    override_file = Path(override_path)
    output_file = Path(output_path)

    if not base_file.exists():
        print(f"ERROR: Base configuration not found: {base_path}")
        return False

    if not override_file.exists():
        print(f"ERROR: Override configuration not found: {override_path}")
        return False

    # Parse base configuration
    try:
        with open(base_file, "r") as f:
            content = f.read()

        # Try YAML parsing first
        try:
            base_config = yaml.safe_load(content)
        except yaml.YAMLError:
            # Fall back to JSON
            with open(base_file, "r") as f:
                base_config = json.load(f)

        print("✓ Base configuration loaded")

    except Exception as e:
        print(f"ERROR: Failed to parse base configuration: {e}")
        return False

    # Parse override configuration
    try:
        with open(override_file, "r") as f:
            content = f.read()

        # Try YAML parsing first
        try:
            override_config = yaml.safe_load(content)
        except yaml.YAMLError:
            # Fall back to JSON
            with open(override_file, "r") as f:
                override_config = json.load(f)

        print("✓ Override configuration loaded")

    except Exception as e:
        print(f"ERROR: Failed to parse override configuration: {e}")
        return False

    # Merge configurations (simple recursive merge)
    def merge_dicts(base, override):
        result = base.copy()

        for key, value in override.items():
            if (
                key in result
                and isinstance(result[key], dict)
                and isinstance(value, dict)
            ):
                result[key] = merge_dicts(result[key], value)
            elif (
                key in result
                and isinstance(result[key], list)
                and isinstance(value, list)
            ):
                # For lists, concatenate (override appends)
                result[key] = result[key] + value
            else:
                result[key] = value

        return result

    merged_config = merge_dicts(base_config, override_config)

    # Write merged configuration
    output_file.parent.mkdir(parents=True, exist_ok=True)

    # Determine format based on output extension
    if output_path.endswith(".yml") or output_path.endswith(".yaml"):
        with open(output_file, "w") as f:
            yaml.dump(merged_config, f, default_flow_style=False, sort_keys=False)
    else:
        with open(output_file, "w") as f:
            json.dump(merged_config, f, indent=2)

    print("✓ Configuration merged successfully")
    print(f"  Output file: {output_file}")
    print(f"  Merged keys: {list(merged_config.keys())}")

    return True


def main():
    parser = argparse.ArgumentParser(description="Merge .mise.toml configurations")
    parser.add_argument(
        "--base", required=True, dest="base_path", help="Base configuration file path"
    )
    parser.add_argument(
        "--override",
        required=True,
        dest="override_path",
        help="Override configuration file path",
    )
    parser.add_argument(
        "--output", required=True, help="Output configuration file path"
    )

    args = parser.parse_args()

    try:
        success = merge_configs(args.base_path, args.override_path, args.output)
        return 0 if success else 1
    except Exception as e:
        print(f"ERROR: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
